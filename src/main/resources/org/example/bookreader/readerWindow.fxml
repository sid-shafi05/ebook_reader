<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<BorderPane prefHeight="750.0" prefWidth="1100.0" style="-fx-background-color: #050508;" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.bookreader.BookController">
   <!-- TOP BAR -->
   <top>
      <VBox spacing="0.0">
         <children>
            <HBox alignment="CENTER_LEFT" prefHeight="52.0" spacing="12.0" style="-fx-background-color: #08080f; -fx-border-color: #0d0d18; -fx-border-width: 0 0 1 0; -fx-padding: 8 20 8 14;">
               <children>
                  <Button onAction="#onBackButtonClick" prefHeight="34.0" prefWidth="110.0" styleClass="back-button" text="← Library"/>
                  <Separator orientation="VERTICAL" style="-fx-background-color: #0d0d18; -fx-pref-width: 1;"/>
                  <Label fx:id="bookTitleLabel" style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #606080; -fx-max-width: 350;" text="Book Title"/>
                  <Region HBox.hgrow="ALWAYS"/>
                  <!-- HIGHLIGHT -->
                  <Button onAction="#enableHighlight" prefHeight="34.0" prefWidth="44.0" style="-fx-background-color: #100e06; -fx-background-radius: 7; -fx-font-size: 15; -fx-cursor: hand; -fx-text-fill: #c8a96e; -fx-border-color: #201a08; -fx-border-width: 1; -fx-border-radius: 7;" text="✎"/>
                  <!-- AI CHAT -->
                  <Button onAction="#toggleChatPanel" prefHeight="34.0" prefWidth="44.0" styleClass="nav-button" text="AI"/>
                  <!-- FOCUS MODE -->
                  <Button fx:id="focusModeButton" onAction="#toggleFocusMode" prefHeight="34.0" prefWidth="44.0" styleClass="nav-button" text="◎"/>
                  <!-- MENU: notebook only now (dark mode removed) -->
                  <Button fx:id="menuButton" prefHeight="34.0" prefWidth="44.0" styleClass="nav-button" text="···" onMousePressed="#showColorFilterMenu"/>
                  <Label fx:id="pageNumberLabel" style="-fx-font-size: 11; -fx-text-fill: #303045; -fx-padding: 0 0 0 6;" text="Page 1 of 1"/>
               </children>
            </HBox>
            <!-- PAGE SLIDER -->
            <HBox fx:id="sliderSection" alignment="CENTER" spacing="10.0" style="-fx-background-color: #06060e; -fx-border-color: #0d0d18; -fx-border-width: 0 0 1 0; -fx-padding: 10 16 10 16;">
               <children>
                  <Label fx:id="sliderMinLabel" style="-fx-font-size: 10; -fx-font-weight: bold; -fx-text-fill: #252535;" text="1"/>
                  <Slider fx:id="pageSlider" HBox.hgrow="ALWAYS" max="100.0" min="1.0" prefWidth="200.0" value="1.0"/>
                  <Label fx:id="sliderMaxLabel" style="-fx-font-size: 10; -fx-font-weight: bold; -fx-text-fill: #252535;" text="100"/>
                  <Label fx:id="sliderCurrentPageLabel" style="-fx-font-size: 10; -fx-font-weight: bold; -fx-text-fill: #c8a96e; -fx-padding: 2 8 2 8; -fx-background-color: #10100a; -fx-background-radius: 4; -fx-border-color: #c8a96e; -fx-border-width: 1; -fx-border-radius: 4;" text="Page 1" minWidth="60.0"/>
               </children>
            </HBox>
         </children>
      </VBox>
   </top>
   <!-- CENTER -->
   <center>
      <HBox spacing="0.0">
         <children>
            <!-- MAIN PAGE VIEW -->
            <ScrollPane fx:id="pageScrollPane" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" style="-fx-background: #050508; -fx-background-color: #050508;" HBox.hgrow="ALWAYS">
               <content>
                  <StackPane style="-fx-background-color: #050508; -fx-padding: 24;">
                     <StackPane style="-fx-background-color: white;" StackPane.alignment="CENTER">
                        <ImageView fx:id="pdfView" pickOnBounds="true" preserveRatio="true" smooth="true" fitWidth="900.0" StackPane.alignment="CENTER"/>
                        <Canvas fx:id="highlightCanvas" width="900" height="1200" StackPane.alignment="CENTER"/>
                     </StackPane>
                  </StackPane>
               </content>
            </ScrollPane>
            <!-- NOTEBOOK PANEL -->
            <VBox fx:id="notebookPanel" spacing="8.0" style="-fx-background-color: #06060e; -fx-border-color: #0d0d18; -fx-border-width: 0 0 0 1; -fx-padding: 14;" prefWidth="275.0" minWidth="275.0" maxWidth="275.0" visible="false" managed="false">
               <children>
                  <HBox alignment="CENTER" spacing="8.0">
                     <children>
                        <Label style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #c8a96e; -fx-letter-spacing: 0.5px;" text="✎ Notes"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="closeNotebookButton" onAction="#toggleNotebookPanel" prefHeight="28.0" prefWidth="28.0" styleClass="nav-button" text="✕"/>
                     </children>
                  </HBox>
                  <Separator style="-fx-background-color: #0d0d18;"/>
                  <TextArea fx:id="notesTextArea" wrapText="true" VBox.vgrow="ALWAYS" promptText="Write your notes here..."/>
                  <Button onAction="#saveNotesPanel" prefHeight="34.0" maxWidth="Infinity" style="-fx-background-color: #1a1508; -fx-text-fill: #c8a96e; -fx-font-size: 11; -fx-padding: 8; -fx-background-radius: 7; -fx-cursor: hand; -fx-border-color: #c8a96e; -fx-border-width: 1; -fx-border-radius: 7; -fx-font-weight: bold;" text="Save Notes"/>
               </children>
            </VBox>
            <!-- AI CHAT PANEL -->
            <VBox fx:id="chatPanel" spacing="8.0" style="-fx-background-color: #06060e; -fx-border-color: #0d0d18; -fx-border-width: 0 0 0 1; -fx-padding: 14;" prefWidth="275.0" minWidth="275.0" maxWidth="275.0" visible="false" managed="false">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="8.0">
                     <children>
                        <Label style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #c8a96e;" text="AI Ask"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button onAction="#toggleChatPanel" prefHeight="28.0" prefWidth="28.0" styleClass="nav-button" text="✕"/>
                     </children>
                  </HBox>
                  <Separator style="-fx-background-color: #0d0d18;"/>
                  <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-background: transparent;">
                     <content>
                        <VBox fx:id="chatMessages" spacing="10.0" style="-fx-padding: 4; -fx-background-color: transparent;"/>
                     </content>
                  </ScrollPane>
                  <TextField fx:id="chatInput" promptText="Ask about this page..." onAction="#sendChatMessage"/>
                  <Button onAction="#sendChatMessage" text="Send →" maxWidth="Infinity" prefHeight="34.0" style="-fx-background-color: #1a1508; -fx-text-fill: #c8a96e; -fx-background-radius: 7; -fx-cursor: hand; -fx-font-weight: bold; -fx-border-color: #c8a96e; -fx-border-width: 1; -fx-border-radius: 7; -fx-font-size: 11;"/>
               </children>
            </VBox>
         </children>
      </HBox>
   </center>
   <!-- BOTTOM TOOLBAR -->
   <bottom>
      <HBox alignment="CENTER" spacing="14.0" style="-fx-background-color: #06060e; -fx-border-color: #0d0d18; -fx-border-width: 1 0 0 0; -fx-padding: 12 28 12 28;">
         <children>
            <!-- PREV -->
            <Button onAction="#prevButtonLogic" prefHeight="38.0" prefWidth="120.0" styleClass="nav-button" text="◄ Prev"/>
            <Region HBox.hgrow="ALWAYS"/>
            <!-- BOOKMARK CONTROLS -->
            <HBox fx:id="controlsSection" alignment="CENTER" spacing="10.0">
               <children>
                  <!--
                   Bookmark toggle — gold star icon, clearly visible
                  -->
                  <Button fx:id="bookmarkButton" onAction="#toggleBookmark" prefHeight="36.0" prefWidth="44.0" styleClass="bookmark-button" text="★"/>
                  <Button onAction="#showBookmarksPanel" prefHeight="36.0" prefWidth="130.0" styleClass="view-bookmarks-button" text="★ Bookmarks"/>
               </children>
            </HBox>
            <!-- ZOOM CONTROLS -->
            <HBox alignment="CENTER" spacing="4.0" style="-fx-background-color: #08080f; -fx-background-radius: 7; -fx-padding: 4 8 4 8; -fx-border-color: #101020; -fx-border-width: 1; -fx-border-radius: 7;">
               <children>
                  <Button onAction="#zoomOut" prefHeight="28.0" prefWidth="28.0" style="-fx-background-color: transparent; -fx-text-fill: #404058; -fx-background-radius: 5; -fx-cursor: hand; -fx-font-size: 15; -fx-font-weight: bold;" text="−"/>
                  <Button fx:id="zoomResetBtn" onAction="#zoomReset" prefHeight="28.0" prefWidth="50.0" style="-fx-background-color: transparent; -fx-text-fill: #c8a96e; -fx-background-radius: 5; -fx-cursor: hand; -fx-font-size: 10; -fx-font-weight: bold;" text="100%"/>
                  <Button onAction="#zoomIn" prefHeight="28.0" prefWidth="28.0" style="-fx-background-color: transparent; -fx-text-fill: #404058; -fx-background-radius: 5; -fx-cursor: hand; -fx-font-size: 15; -fx-font-weight: bold;" text="+"/>
               </children>
            </HBox>
            <Region HBox.hgrow="ALWAYS"/>
            <!-- NEXT -->
            <Button onAction="#nextButtonLogic" prefHeight="38.0" prefWidth="120.0" styleClass="nav-button" text="Next ►"/>
         </children>
      </HBox>
   </bottom>
</BorderPane>